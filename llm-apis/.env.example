# ─── Provider APIs ────────────────────────────────────────────────────────────
# Cohere (1,000 calls/month)         → https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Google Gemini (250–1,000 RPD)      → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mistral AI (~1B tokens/month)      → https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Z AI / Zhipu AI (permanent free)   → https://open.bigmodel.cn/usercenter/apikeys
ZAI_API_KEY=

# ─── Inference Providers ──────────────────────────────────────────────────────
# Cerebras (~2,600 tok/s, 1M TPD)    → https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Cloudflare Workers AI              → https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub Models (50–150 RPD)         → https://github.com/settings/tokens
GITHUB_TOKEN=

# Groq (ultra-fast LPU, 14,400 RPD) → https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face (~$0.10/month free)   → https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Kilo Code (~200 req/hr)            → https://kilo.ai
KILOCODE_API_KEY=

# LLM7.io (30–120 RPM, no signup)    → https://token.llm7.io
LLM7_API_KEY=

# ModelScope (2,000 RPD)             → https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=

# NVIDIA NIM (~40 RPM, no daily cap) → https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=

# Ollama Cloud (session/weekly)      → https://ollama.com/settings/keys
OLLAMA_API_KEY=

# OpenRouter (200 RPD, 35+ :free)    → https://openrouter.ai/keys
OPENROUTER_API_KEY=

# SiliconFlow (1,000 RPM, 50K TPM)   → https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=
